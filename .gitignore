# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — the site's and the contracts' (contracts/ has its own package.json)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the examples are meant to be committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hardhat (contracts/) — everything `hardhat compile` regenerates; the ABI +
# bytecode the site needs are exported into src/lib/abi and ARE committed
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/dist/
contracts/deployments/local.json

# screenshots (regenerate with `npm run capture`)
/captures/

# logs
*.log

# ORBIT — the market as a solar system on Robinhood Chain.
# Nothing here is required: the Sun's address is deterministic and the site
# reads whether it exists. Every value is an override.

# Point the site at another Sun on purpose (a rehearsal against the Pons
# mock on a local network, say). Normally unset.
# NEXT_PUBLIC_SUN=

# Robinhood Chain (defaults shown). A seeded local fork:
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8571
# NEXT_PUBLIC_CHAIN_ID=4663
# NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Public URL of this deployment (metadata, OG image, the default logo URL on /deploy).
# NEXT_PUBLIC_SITE_URL=https://orbit.example

# WalletConnect project id — with it RainbowKit offers its full wallet list;
# without it, injected wallets only.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Dev only: install the key-less EIP-1193 stub (public/dev-wallet.js) that
# sends from an unlocked hardhat account on the seeded fork.
# NEXT_PUBLIC_DEV_WALLET=1
